{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Практика 4: открыть Mattermost",
      "type": "process",
      "command": "/usr/bin/open",
      "args": [
        "http://localhost:8065"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Практика 4: показать контейнеры",
      "type": "process",
      "command": "/Applications/Docker.app/Contents/Resources/bin/docker",
      "args": [
        "ps",
        "--filter",
        "label=com.docker.compose.project=mattermostpr4"
      ],
      "problemMatcher": []
    },
    {
      "label": "Практика 4: проверить API",
      "type": "process",
      "command": "/usr/bin/curl",
      "args": [
        "-f",
        "http://localhost:8065/api/v4/system/ping"
      ],
      "problemMatcher": []
    }
  ]
}
