{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Практика 5: собрать и проверить установку через APT",
      "type": "process",
      "command": "/bin/sh",
      "args": [
        "${workspaceFolder}/scripts/show-package.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Практика 5: открыть Nexus",
      "type": "process",
      "command": "/usr/bin/open",
      "args": [
        "http://localhost:8081"
      ],
      "problemMatcher": []
    },
    {
      "label": "Практика 5: показать метаданные APT",
      "type": "process",
      "command": "/usr/bin/curl",
      "args": [
        "-fsS",
        "http://localhost:8081/repository/syspulse/dists/stable/Release"
      ],
      "problemMatcher": []
    }
  ]
}
